@startuml
!define RECTANGLE class

RECTANGLE Patient {
  +identifier: Identifier
  ...
}

RECTANGLE "CareTeam\n(Patient)" as CareTeam {
  +participant: Reference(Practitioner | RelatedPerson | OrgCareTeam)
  ...
}

RECTANGLE "CareTeam\n(Organizational)" as OrgCareTeam {
  +name: string
  +managingOrganization: Reference(Organization)
  +participant: Reference(Practitioner)
  ...
}

RECTANGLE CommunicationRequest {
  +status: code
  +subject: Reference(Patient)
  +sender: Reference(Practitioner | RelatedPerson)
  +extension[senderCareTeam]: Reference(OrgCareTeam)
  +recipient: Reference(CareTeam | OrgCareTeam | Practitioner | RelatedPerson)
  +payload.contentString: string : "The message"
  +payload.contentAttachment: Attachment
  ...
}

RECTANGLE Communication {
  +partOf: Reference(CommunicationRequest)
  +sender: Reference(Practitioner | RelatedPerson | Patient)
  +extension[senderCareTeam]: Reference(OrgCareTeam)
  +payload.contentString: string : "The message"
  +payload.contentAttachment: Attachment
  ...
}

RECTANGLE Attachment {
  +contentType: code
  +data: base64Binary
  ...
}

RECTANGLE Task {
  +status: code
  +owner: Reference(OrgCareTeam | Practitioner | RelatedPerson | Patient)
  +focus: Reference(Communication)
  +basedOn: Reference(CommunicationRequest)
  ...
}

RECTANGLE AuditEvent {
  +entity.what: Reference(CommunicationRequest | Communication)
  +agent.who: Reference(Practitioner | RelatedPerson)
  +agent.extension[careTeam]: Reference(OrgCareTeam)
  +action: code
  ...
}


Patient "1" <-- "1..*" CareTeam : has >
CareTeam "1..*" -right-> CommunicationRequest : requests communication >
OrgCareTeam "0..*" -right-> CommunicationRequest : senderCareTeam/recipient >
OrgCareTeam "1" <-- "0..*" Task : owner (one Task per team) >
CommunicationRequest <-- "0..*" Communication : part of
Communication <-- "0..*" Task : is focus of >
CommunicationRequest "0..*" -- Attachment : includes >
Communication "0..*" -- Attachment : includes >
Task "0..*" -left-> "1" CommunicationRequest : based on >
AuditEvent  - "1" CommunicationRequest: entity (read receipt)
Patient  ---- AuditEvent: who
@enduml
